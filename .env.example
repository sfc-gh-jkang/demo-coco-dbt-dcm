# ============================================================================
# demo-coco-dbt-dcm — deploy config
# ============================================================================
# Copy this file to `.env` and adjust values.
#
# deploy.py will not proceed unless `.env` exists and
# `I_UNDERSTAND_THIS_WILL_OVERWRITE_TARGET_DATABASE=1`.
# ============================================================================

# Snowflake connection name (from `snow connection list`)
SNOWFLAKE_CONNECTION=default

# Target database for the demo pipeline.
# Change to anything (e.g., PAWCORE_SANDBOX_<your-name>) to avoid conflicts.
# WARNING: existing tables in DEVICE_DATA / MANUFACTURING / SUPPORT schemas
# WILL be overwritten by the dbt build.
TARGET_DATABASE=PAWCORE_ANALYTICS

# Target warehouse — created if missing
TARGET_WAREHOUSE=PAWCORE_DEMO_WH

# Safety gate: set to 1 ONLY after you have reviewed TARGET_DATABASE above.
I_UNDERSTAND_THIS_WILL_OVERWRITE_TARGET_DATABASE=0
