# ============================================================================
# demo-coco-dbt-dcm — deploy config
# ============================================================================
# Copy this file to `.env` and adjust values.
#
# deploy.sh will refuse to proceed unless `.env` exists and is explicitly
# acknowledged. This prevents accidental deploys into the wrong database
# (e.g., overwriting an existing HOL's PAWCORE_ANALYTICS tables).
# ============================================================================

# Snowflake connection name (from `snow connection list`)
SNOWFLAKE_CONNECTION=default

# Target database for the demo pipeline.
#
# DEFAULT: PAWCORE_ANALYTICS (works out of the box, HOL-compatible)
#
# CUSTOM DB: change this to anything else (e.g. PAWCORE_SANDBOX_<your-name>).
# deploy.sh substitutes ${TARGET_DB} into dbt/profiles.yml + dbt/models/sources.yml +
# dcm/sources/definitions/schemas.sql at PUT time. .env is the single knob.
#
# WARNING: if TARGET_DATABASE already exists with tables in DEVICE_DATA /
# MANUFACTURING / SUPPORT schemas, they WILL be overwritten by the dbt build.
TARGET_DATABASE=PAWCORE_ANALYTICS

# Target warehouse — created if missing
TARGET_WAREHOUSE=PAWCORE_DEMO_WH

# GitHub PAT — only needed if you fork this repo and keep your fork private.
# This upstream repo is public, so leave this blank for normal use.
# Generate at: https://github.com/settings/tokens (classic, `repo` scope)
GITHUB_PAT=

# Your GitHub username (owner of the PAT)
GITHUB_USER=sfc-gh-jkang

# Safety gate: set to 1 ONLY after you have reviewed TARGET_DATABASE above and
# accept that its contents may be overwritten. deploy.sh will refuse unless
# this is 1.
I_UNDERSTAND_THIS_WILL_OVERWRITE_TARGET_DATABASE=0
