# dbt profiles.yml — used for LOCAL dbt dev (optional; the demo itself runs
# via native `CREATE DBT PROJECT` on Snowflake, which does not use this file).
#
# For local dev: set SNOWFLAKE_ACCOUNT and SNOWFLAKE_USER in env, or copy this
# file to ~/.dbt/profiles.yml and edit account/user directly.

pawcore:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      authenticator: externalbrowser
      role: ACCOUNTADMIN
      database: PAWCORE_ANALYTICS
      warehouse: PAWCORE_DEMO_WH
      schema: DBT_DEV  # overridden per-model via +schema + generate_schema_name
      threads: 4
